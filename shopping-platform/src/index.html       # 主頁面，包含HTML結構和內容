<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>互動式購物平台</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <header>
        <h1>歡迎來到互動式購物平台</h1>
        <nav>
            <ul>
                <li><a href="#products">產品列表</a></li>
                <li><a href="#cart">購物車</a></li>
            </ul>
        </nav>
    </header>
    
    <main>
        <section id="products">
            <h2>產品列表</h2>
            <div id="product-list">
                <!-- 產品項目將由JavaScript動態生成 -->
            </div>
        </section>
        
        <section id="cart">
            <h2>購物車</h2>
            <div id="cart-items">
                <!-- 購物車項目將由JavaScript動態生成 -->
            </div>
            <button id="checkout-button">結帳</button>
        </section>
    </main>

    <footer>
        <p>&copy; 2023 互動式購物平台. 版權所有.</p>
    </footer>

    <script src="js/app.js"></script>
</body>
</html>